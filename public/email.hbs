<div style="font-family:Arial,sans-serif;max-width:640px;margin:auto">
  <h1>Portfolio session summary</h1>
  <p><strong>Visitor:</strong> {{#if visitor}}{{visitor.visitorId}}{{else}}Automated traffic{{/if}}</p>
  <p><strong>Session:</strong> {{session.sessionId}}</p>
  <p><strong>Classification:</strong> {{session.classification}}</p>
  <p><strong>Location:</strong> {{session.location.city}}, {{session.location.country}}</p>
  <p><strong>Network:</strong> {{session.network.isp}} {{session.network.as}}</p>
  <p><strong>Started:</strong> {{session.startedAt}}</p>
  <p><strong>Page:</strong> {{session.context.page}}</p>
  <p><strong>Referrer:</strong> {{session.context.referrer}}</p>
  <p><strong>Language / timezone:</strong> {{session.context.language}} / {{session.context.timezone}}</p>
  <p><strong>User agent:</strong> {{session.userAgent}}</p>
  <p><strong>Browser / OS:</strong> {{session.client.browser.name}} {{session.client.browser.version}} / {{session.client.os.name}} {{session.client.os.version}}</p>
  <h2>Activity</h2>
  <ol>
    {{#each events}}
      <li><strong>{{type}}</strong> — {{page}} — {{occurredAt}}{{#if metadata.project}} — {{metadata.project}}{{/if}}</li>
    {{/each}}
  </ol>
</div>

<!doctype html>
<html lang="en">
<body style="margin:0;background:#eef2f7;font-family:Arial,sans-serif;color:#172033">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#eef2f7;padding:24px 12px">
    <tr><td align="center">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:680px;background:#ffffff;border-radius:16px;overflow:hidden;box-shadow:0 8px 28px rgba(23,32,51,.12)">
        <tr><td style="padding:32px;background:#172033;color:#ffffff">
          <div style="font-size:12px;letter-spacing:1.6px;text-transform:uppercase;color:#86a8ff">Portfolio analytics</div>
          <h1 style="margin:8px 0 4px;font-size:28px;line-height:1.2">Session summary</h1>
          <div style="color:#c8d2e5">{{session.startedAt}}</div>
        </td></tr>

        <tr><td style="padding:24px">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0">
            <tr><td style="padding:18px;background:#f6f8fc;border:1px solid #e4e9f2;border-radius:12px">
              <div style="font-size:12px;text-transform:uppercase;letter-spacing:1px;color:#68758a">Visitor</div>
              <div style="margin-top:7px;font-size:16px;font-weight:bold">{{#if visitor}}{{#if visitor.nickname}}{{visitor.nickname}}{{else}}{{visitor.visitorId}}{{/if}}{{else}}Automated traffic{{/if}}</div>
              <div style="margin-top:5px;font-size:13px;color:#68758a">{{session.classification}} · {{session.sessionId}}</div>
            </td></tr>
          </table>

          <h2 style="margin:26px 0 10px;font-size:17px">Location &amp; network</h2>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border:1px solid #e4e9f2;border-radius:12px">
            <tr><td style="padding:16px 18px;border-bottom:1px solid #e4e9f2">
              <div style="font-weight:bold">{{session.location.city}}, {{session.location.regionName}}, {{session.location.country}}</div>
              <div style="margin-top:5px;font-size:13px;color:#68758a">{{session.location.lat}}, {{session.location.lon}} · {{session.location.timezone}}</div>
              {{#if mapsUrl}}<a href="{{{mapsUrl}}}" style="display:inline-block;margin-top:12px;padding:10px 15px;background:#356ae6;color:#ffffff;text-decoration:none;font-size:13px;font-weight:bold;border-radius:8px">Open in Google Maps</a>{{/if}}
            </td></tr>
            <tr><td style="padding:16px 18px;font-size:14px">
              <strong>{{session.network.isp}}</strong><br>
              <span style="color:#68758a">{{session.network.org}} · {{session.network.as}} · IP {{session.ip}}</span>
            </td></tr>
          </table>

          <h2 style="margin:26px 0 10px;font-size:17px">Visit context</h2>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="font-size:14px;border:1px solid #e4e9f2;border-radius:12px">
            <tr><td style="padding:12px 18px;color:#68758a;width:120px">Page</td><td style="padding:12px 18px">{{session.context.page}}</td></tr>
            <tr style="background:#f8faff"><td style="padding:12px 18px;color:#68758a">Referrer</td><td style="padding:12px 18px">{{session.context.referrer}}</td></tr>
            <tr><td style="padding:12px 18px;color:#68758a">Locale</td><td style="padding:12px 18px">{{session.context.language}} · {{session.context.timezone}}</td></tr>
            <tr style="background:#f8faff"><td style="padding:12px 18px;color:#68758a">Browser</td><td style="padding:12px 18px">{{session.client.browser.name}} {{session.client.browser.version}} on {{session.client.os.name}} {{session.client.os.version}}</td></tr>
            <tr><td style="padding:12px 18px;color:#68758a">User agent</td><td style="padding:12px 18px;word-break:break-word">{{session.userAgent}}</td></tr>
          </table>

          <h2 style="margin:26px 0 10px;font-size:17px">Activity</h2>
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="font-size:14px;border:1px solid #e4e9f2;border-radius:12px">
            {{#each events}}
            <tr><td style="padding:14px 18px;border-bottom:1px solid #e4e9f2">
              <strong style="color:#356ae6">{{type}}</strong>{{#if metadata.project}} · {{metadata.project}}{{/if}}<br>
              <span style="color:#68758a">{{page}} · {{occurredAt}}</span>
            </td></tr>
            {{/each}}
          </table>
        </td></tr>

        <tr><td style="padding:18px 24px;background:#f6f8fc;text-align:center;font-size:12px;color:#8490a3">Generated by tracker-mailer</td></tr>
      </table>
    </td></tr>
  </table>
</body>
</html>
